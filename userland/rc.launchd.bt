# etc/rc for Bluetooth's runs (BT=1): what rc.launchd.aks does before launchd (the system bag made as a
# restore would, then launchd's own boot task "keybag", skipped when it boots from a RAM disk) and what
# rc.launchd.metal does (our Metal plug-in's name on IOAcceleratorES; needs boot-arg metal=1). Bluetooth
# wants both: bluetoothd keeps its identity root in the keychain, and Settings draws with Metal.
/redwood/bin/tolog /redwood/bin/aks_restore
/redwood/bin/tolog OS_ACTIVITY_DT_MODE=YES /usr/libexec/keybagd --init
/redwood/bin/tolog /redwood/bin/metal_props on ../../../redwood/lib/RedwoodMetal RedwoodMetalDevice
exec /sbin/launchd.ios
